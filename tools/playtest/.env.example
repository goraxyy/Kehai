# Playtest builds read these (KehaiBuild -playtest, Kehai → Build → Playtest). Copy this file to
# tools/playtest/.env, which git ignores, and fill it in. See PLAYTEST.md.

# The round this build belongs to: round1, round2…
KEHAI_PLAYTEST_ROUND=round1

# The upload service (step 2) and its key. Empty: sessions stay on the tester's computer.
KEHAI_PLAYTEST_UPLOAD_URL=
KEHAI_PLAYTEST_UPLOAD_KEY=

# The Google Form's pre-filled link, with {code} where the tester code goes.
KEHAI_PLAYTEST_FORM_URL=

# After how many shifts the game suggests stopping.
KEHAI_PLAYTEST_SUGGEST_AFTER=3

# Your Mac's side only (never put into a build): reads and deletes sessions on the upload service.
KEHAI_PLAYTEST_ADMIN_KEY=

# Where playtest bug notes are filed once you approve them in Telegram.
KEHAI_ISSUES_REPO=goraxyy/Kehai

# For the tester messages (make_codes.py): where they download, and the itch page's password.
KEHAI_PLAYTEST_ITCH_URL=
KEHAI_PLAYTEST_ITCH_PASSWORD=
KEHAI_PLAYTEST_MAC_LINK=
KEHAI_PLAYTEST_WINDOWS_LINK=
