  "metrics": {
    "caught": {
      "group": "pacing",
      "target": [
        0.2,
        0.35
      ],
      "rule": "mean binary catches on shifts 2-4; career SE"
    },
    "panic_setpoint_rmse": {
      "group": "pacing",
      "better": "lower",
      "rule": "mean recorded per-shift RMSE, shifts 2-4; career SE"
    },
    "fairness_violations": {
      "group": "safety",
      "target": 0,
      "rule": "mean per shift; any nonzero observation fails, shifts 2-4"
    },
    "stuck": {
      "group": "safety",
      "better": "lower",
      "rule": "mean explicit binary stuck flag on all four shifts"
    },
    "top_trick_share": {
      "group": "pacing",
      "target_max": 0.4,
      "rule": "within-career pooled trick counts, shifts 2-4: largest count / all picks; mean and career SE; gate also checks pooled stratum picks <= 0.4; missing counts unavailable"
    },
    "true_mass_oov": {
      "group": "prediction",
      "better": "higher",
      "rule": "mean recorded true-cell probability out of view, shifts 2-4"
    },
    "true_mass_5s": {
      "group": "prediction",
      "better": "higher",
      "rule": "mean true-cell probability recorded 5 seconds after loss, shifts 2-4"
    },
    "true_mass_10s": {
      "group": "prediction",
      "better": "higher",
      "rule": "mean true-cell probability recorded 10 seconds after loss, shifts 2-4"
    },
    "true_mass_20s": {
      "group": "prediction",
      "better": "higher",
      "rule": "mean true-cell probability recorded 20 seconds after loss, shifts 2-4"
    },
    "calibration_brier": {
      "group": "prediction",
      "better": "lower",
      "rule": "recorded mean squared probability error for predeclared binary occupancy events, shifts 2-4"
    },
    "bot_human_accuracy": {
      "group": "players",
      "target": 0.5,
      "rule": "mean out-of-fold held-out-player bot/human classification accuracy per career; requires consented human reference and player-split provenance; career SE is descriptive"
    },
    "bot_jobs_per_min": {
      "group": "players",
      "rule": "recorded jobs per minute on all shifts, shown beside Karen scores"
    },
    "belief_ms": {
      "group": "speed",
      "target_max": 0.7,
      "rule": "recorded mean belief CPU milliseconds/frame, shifts 2-4"
    },
    "catch_rmst_s": {
      "group": "hunting",
      "better": "lower",
      "rule": "Vital only, pacing off; Kaplan-Meier restricted mean to 150s, right censoring, delete-one-career jackknife SE"
    },
    "adaptation_rmse_delta": {
      "group": "learning",
      "better": "lower",
      "rule": "paired retained minus wiped RMSE on shifts 2-4 within seed, layout, player and model; career SE"
    }
  },
