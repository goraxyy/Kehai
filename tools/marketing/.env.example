# Copy to .env (gitignored) and fill in what you have; an empty value counts as not set. Nothing
# here is ever committed or printed. Step by step: BUILD_PLAN.md, "Owner setup checklist".

# 1. Claude (https://platform.claude.com): a workspace with a $15 monthly spend limit, credits,
#    and a key made in that workspace (starts with sk-ant-).
ANTHROPIC_API_KEY=
# The pipeline's own cap, checked before every call (the Console limit is the hard stop behind it).
KEHAI_LLM_MONTHLY_USD=15
# Set to off if the API ever rejects server-side refusal fallbacks.
KEHAI_LLM_FALLBACK=default

# 2. Azure Speech, free tier F0 (https://portal.azure.com/#create/Microsoft.CognitiveServicesSpeechServices):
#    the resource's "Keys and Endpoint" page shows KEY 1 and the location/region (e.g. eastus).
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
KEHAI_AZURE_MONTHLY_CHARS=500000
# The same key transcribes reference videos (free tier: 5 audio hours a month).
KEHAI_AZURE_STT_MONTHLY_SECONDS=18000

# 3. Telegram approvals: @BotFather (https://t.me/BotFather) → /newbot gives the token. Then send
#    /start to your bot and run `uv run run_job.py telegram-setup`: it prints your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 4. Buffer (https://publish.buffer.com/settings/api), once YouTube, Instagram and X or Bluesky are connected.
BUFFER_API_KEY=

# 5. Where Buffer fetches videos from (it refuses Drive links; Q8): a Cloudflare R2 bucket named
#    kehai-public with its Public Development URL enabled, and an R2 API token (Object Read & Write,
#    that bucket only). rclone reads the RCLONE_CONFIG_R2_* lines as its `r2` remote, so there's
#    nothing to set up in rclone itself; it only has to be installed (brew install rclone).
KEHAI_PUBLIC_REMOTE=r2:kehai-public
# The bucket's Public Development URL, e.g. https://pub-0123456789abcdef.r2.dev
KEHAI_PUBLIC_URL=
RCLONE_CONFIG_R2_TYPE=s3
RCLONE_CONFIG_R2_PROVIDER=Cloudflare
RCLONE_CONFIG_R2_ACL=private
RCLONE_CONFIG_R2_NO_CHECK_BUCKET=true
# The token's Access Key ID and Secret Access Key, and https://<account id>.r2.cloudflarestorage.com
RCLONE_CONFIG_R2_ACCESS_KEY_ID=
RCLONE_CONFIG_R2_SECRET_ACCESS_KEY=
RCLONE_CONFIG_R2_ENDPOINT=

# 6. The Drive archive (Q7) is rclone's own `gdrive` remote (a sign-in, so no key here):
#    rclone config create gdrive drive scope=drive.file
# KEHAI_RCLONE_REMOTE=gdrive

# Optional: ElevenLabs as a voice backend.
ELEVENLABS_API_KEY=
KEHAI_ELEVENLABS_MONTHLY_CHARS=10000

# Trial runs: speak with the macOS voices; answer the Claude steps from files.
# KEHAI_TTS_BACKEND=say
# KEHAI_LLM_REPLAY=

# Where things are (defaults shown).
# KEHAI_MARKETING=~/TokenLimit/marketing
# KEHAI_SHIFT_RECORDS=~/Library/Application Support/TokenLimit/Kehai/shift_records
# KEHAI_LOCK_WAIT=0
