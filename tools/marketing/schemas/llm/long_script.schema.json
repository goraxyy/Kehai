{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/goraxyy/Kehai/tools/marketing/schemas/llm/long_script.schema.json",
  "title": "The monthly long video's script (what Claude writes)",
  "description": "long_video.py script: the voice-over, section by section, with what is on screen under each line. The owner approves it; then it is voiced, and the edit is timed to the voice.",
  "type": "object",
  "additionalProperties": false,
  "required": ["sections"],
  "properties": {
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "lines"],
        "properties": {
          "name": { "type": "string" },
          "lines": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["speaker", "text", "cue"],
              "properties": {
                "speaker": { "enum": ["narrator", "karen"] },
                "text": { "type": "string", "description": "Written to be spoken, in English." },
                "cue": { "type": "string", "description": "What is on screen under it: shot names from the outline, or a title card." }
              }
            }
          }
        }
      }
    }
  }
}
