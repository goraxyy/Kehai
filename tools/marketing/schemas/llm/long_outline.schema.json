{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/goraxyy/Kehai/tools/marketing/schemas/llm/long_outline.schema.json",
  "title": "The monthly long video's outline (what Claude writes)",
  "description": "long_video.py outline: the sections, their beats, and the shots to render for them. The owner approves it before the script is written.",
  "type": "object",
  "additionalProperties": false,
  "required": ["title_ideas", "logline", "sections", "cta"],
  "properties": {
    "title_ideas": { "type": "array", "description": "Three to five.", "items": { "type": "string" } },
    "logline": { "type": "string", "description": "The video in one sentence." },
    "sections": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/section" } },
    "cta": { "type": "string" }
  },
  "$defs": {
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "minutes", "purpose", "beats", "shots"],
      "properties": {
        "name": { "type": "string" },
        "minutes": { "type": "number" },
        "purpose": { "type": "string", "description": "What the viewer gets from it." },
        "beats": { "type": "array", "items": { "type": "string" } },
        "shots": { "type": "array", "items": { "$ref": "#/$defs/shot" } }
      }
    },
    "shot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "moment", "camera", "subject", "layers", "alpha", "start_offset", "end_offset"],
      "properties": {
        "name": { "type": "string", "description": "Lowercase words joined by dashes, unique in the outline." },
        "moment": { "type": "string", "description": "<stem>#<rank> from the digest." },
        "camera": { "enum": ["pov", "cctv", "chase", "orbit", "topdown"] },
        "subject": { "enum": ["karen", "you"] },
        "layers": { "type": "array", "items": { "enum": ["belief", "guess", "cone", "sound", "thoughts", "actors"] } },
        "alpha": { "type": "boolean" },
        "start_offset": { "type": "number" },
        "end_offset": { "type": "number" }
      }
    }
  }
}
