{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/goraxyy/Kehai/tools/marketing/schemas/edit.schema.json",
  "title": "Kehai video edit",
  "description": "One video, as data: tools/marketing/editor renders it (Remotion) and the Python steps write and revise it. Times are seconds. Files are paths relative to the marketing working folder (~/TokenLimit/marketing). Scenes play one after another; a scene's transition overlaps it with the one before, so the video is the sum of the scene durations minus the transitions. Voice clips and music are placed on the whole video's clock; overlays and sound effects on their scene's.",
  "type": "object",
  "required": ["version", "id", "kind", "format", "fps", "languages", "scenes"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{2,80}$", "description": "Names the output files: <id>.<language>.mp4." },
    "kind": { "enum": ["short", "long"] },
    "format": { "enum": ["9:16", "16:9"], "description": "9:16 renders 1080×1920; 16:9 renders 1920×1080." },
    "fps": { "enum": [24, 25, 30, 60] },
    "languages": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "$ref": "#/$defs/language" },
      "description": "One video file per language: its voice track, captions and text."
    },
    "title": { "$ref": "#/$defs/text" },
    "source": {
      "type": "object",
      "description": "Where the footage came from, for the record.",
      "additionalProperties": false,
      "properties": {
        "stem": { "type": "string" },
        "moments": { "type": "array", "items": { "type": "integer", "minimum": 1 } },
        "notes": { "type": "string" }
      }
    },
    "scenes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/scene" } },
    "script": {
      "type": "array",
      "description": "The voice-over as written, before it is spoken: voice.py speaks each line in each language into `voice`. The renderer plays `voice` and ignores this.",
      "items": { "$ref": "#/$defs/scriptLine" }
    },
    "voice": {
      "type": "object",
      "description": "Voice-over per language.",
      "propertyNames": { "$ref": "#/$defs/language" },
      "additionalProperties": { "type": "array", "items": { "$ref": "#/$defs/voiceClip" } }
    },
    "music": { "$ref": "#/$defs/music" },
    "captions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": { "enum": ["words", "lines", "off"], "default": "words", "description": "words: a few words at a time, the one being said lit up; lines: whole lines." },
        "position": { "enum": ["top", "middle", "bottom"], "default": "bottom" },
        "maxWords": { "type": "integer", "minimum": 1, "maximum": 12, "default": 4 }
      }
    },
    "endCard": {
      "type": "object",
      "description": "Added after the last scene.",
      "required": ["duration"],
      "additionalProperties": false,
      "properties": {
        "duration": { "type": "number", "minimum": 0.5, "maximum": 15 },
        "cta": { "$ref": "#/$defs/text" },
        "showHandles": { "type": "boolean", "default": true }
      }
    }
  },
  "$defs": {
    "language": { "enum": ["en", "ru"] },
    "text": {
      "description": "The same words in every language, or a translation per language.",
      "oneOf": [
        { "type": "string" },
        {
          "type": "object", "minProperties": 1,
          "propertyNames": { "$ref": "#/$defs/language" },
          "additionalProperties": { "type": "string" }
        }
      ]
    },
    "file": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*\\.\\.)[^\\\\]+$", "description": "Relative to the working folder; no absolute paths, no '..'." },
    "fraction": { "type": "number", "minimum": 0, "maximum": 1 },
    "colour": {
      "description": "A brand colour by name, or #RRGGBB.",
      "oneOf": [
        { "enum": ["crimson", "ink", "inkSoft", "paper", "mist", "karen", "you", "guess"] },
        { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" }
      ]
    },
    "span": {
      "type": "object",
      "description": "When, in the scene: from 0 to its end if left out.",
      "properties": {
        "from": { "type": "number", "minimum": 0 },
        "to": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "zoomKey": {
      "type": "object",
      "required": ["at", "scale"],
      "additionalProperties": false,
      "properties": {
        "at": { "type": "number", "minimum": 0, "description": "Seconds into the scene." },
        "scale": { "type": "number", "minimum": 0.5, "maximum": 6 },
        "x": { "$ref": "#/$defs/fraction", "description": "The point zoomed into, across the frame (0 left, 1 right)." },
        "y": { "$ref": "#/$defs/fraction", "description": "…and down it (0 top, 1 bottom)." }
      }
    },
    "speedKey": {
      "type": "object",
      "required": ["at", "rate"],
      "additionalProperties": false,
      "properties": {
        "at": { "type": "number", "minimum": 0, "description": "Seconds into the scene." },
        "rate": { "type": "number", "minimum": 0.1, "maximum": 8 }
      }
    },
    "shot": {
      "type": "object",
      "required": ["type", "src"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "shot" },
        "src": { "$ref": "#/$defs/file" },
        "trim": { "type": "number", "minimum": 0, "default": 0, "description": "Seconds cut from the start of the file." },
        "speed": {
          "description": "A constant rate, or a ramp: keys the rate moves between (smoothly).",
          "oneOf": [
            { "type": "number", "minimum": 0.1, "maximum": 8 },
            { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/speedKey" } }
          ]
        },
        "zoom": { "type": "array", "items": { "$ref": "#/$defs/zoomKey" }, "description": "Zooms and pans: the frame eases from key to key." },
        "volume": { "type": "number", "minimum": 0, "maximum": 2, "default": 0.7, "description": "The game's own sound in the shot; it dips to 35% of this while someone speaks. The finished video is normalised to -14 LUFS." },
        "fit": { "enum": ["cover", "contain"], "default": "cover" },
        "label": { "$ref": "#/$defs/text", "description": "A small tag on the shot (in a split: which side is which)." }
      }
    },
    "visual": {
      "oneOf": [
        { "$ref": "#/$defs/shot" },
        {
          "type": "object",
          "required": ["type", "a", "b"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "split" },
            "direction": { "enum": ["row", "column"], "default": "column", "description": "row: side by side; column: one above the other." },
            "ratio": { "type": "number", "minimum": 0.2, "maximum": 0.8, "default": 0.5 },
            "a": { "$ref": "#/$defs/shot" },
            "b": { "$ref": "#/$defs/shot" }
          }
        },
        {
          "type": "object",
          "required": ["type", "src"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "image" },
            "src": { "$ref": "#/$defs/file" },
            "zoom": { "type": "array", "items": { "$ref": "#/$defs/zoomKey" } },
            "fit": { "enum": ["cover", "contain"], "default": "cover" }
          }
        },
        {
          "type": "object",
          "required": ["type"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "color" },
            "color": { "$ref": "#/$defs/colour" }
          }
        }
      ]
    },
    "pip": {
      "type": "object",
      "description": "Picture in picture: Karen's mind (a -alpha render), or any second shot.",
      "required": ["src"],
      "additionalProperties": false,
      "properties": {
        "src": { "$ref": "#/$defs/file" },
        "trim": { "type": "number", "minimum": 0, "default": 0 },
        "corner": { "enum": ["top-left", "top-right", "bottom-left", "bottom-right"], "default": "top-right" },
        "size": { "type": "number", "minimum": 0.15, "maximum": 0.7, "default": 0.38, "description": "Width, as a fraction of the frame's." },
        "transparent": { "type": "boolean", "default": false, "description": "The file has alpha (a .webm from render_shot.sh -alpha): no box behind it." },
        "label": { "$ref": "#/$defs/text" },
        "from": { "type": "number", "minimum": 0 },
        "to": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "transition": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": { "enum": ["cut", "fade", "slide", "wipe", "flip", "clock"] },
        "duration": { "type": "number", "minimum": 0.1, "maximum": 2, "default": 0.4 },
        "direction": { "enum": ["from-left", "from-right", "from-top", "from-bottom"], "default": "from-right" }
      }
    },
    "overlay": {
      "oneOf": [
        { "$ref": "#/$defs/hook" }, { "$ref": "#/$defs/label" }, { "$ref": "#/$defs/lowerThird" },
        { "$ref": "#/$defs/picture" }, { "$ref": "#/$defs/arrow" }, { "$ref": "#/$defs/circle" },
        { "$ref": "#/$defs/meme" }
      ]
    },
    "hook": {
      "description": "The big line at the top that makes people stay.",
      "allOf": [{ "$ref": "#/$defs/span" }],
      "type": "object",
      "required": ["type", "text"],
      "unevaluatedProperties": false,
      "properties": { "type": { "const": "hook" }, "text": { "$ref": "#/$defs/text" } }
    },
    "label": {
      "allOf": [{ "$ref": "#/$defs/span" }],
      "type": "object",
      "required": ["type", "text", "x", "y"],
      "unevaluatedProperties": false,
      "properties": {
        "type": { "const": "label" },
        "text": { "$ref": "#/$defs/text" },
        "x": { "$ref": "#/$defs/fraction" },
        "y": { "$ref": "#/$defs/fraction" },
        "style": { "enum": ["crimson", "ink", "paper"], "default": "crimson" },
        "size": { "enum": ["s", "m", "l"], "default": "m" }
      }
    },
    "lowerThird": {
      "allOf": [{ "$ref": "#/$defs/span" }],
      "type": "object",
      "required": ["type", "title"],
      "unevaluatedProperties": false,
      "properties": {
        "type": { "const": "lowerThird" },
        "title": { "$ref": "#/$defs/text" },
        "subtitle": { "$ref": "#/$defs/text" }
      }
    },
    "picture": {
      "description": "An image, a GIF or a Lottie animation (.json) placed on the frame.",
      "allOf": [{ "$ref": "#/$defs/span" }],
      "type": "object",
      "required": ["type", "src", "x", "y", "width"],
      "unevaluatedProperties": false,
      "properties": {
        "type": { "enum": ["image", "gif", "lottie"] },
        "src": { "$ref": "#/$defs/file" },
        "x": { "$ref": "#/$defs/fraction", "description": "Centre, across." },
        "y": { "$ref": "#/$defs/fraction", "description": "Centre, down." },
        "width": { "type": "number", "exclusiveMinimum": 0, "maximum": 1, "description": "Fraction of the frame's width." },
        "rotate": { "type": "number", "minimum": -180, "maximum": 180, "default": 0 },
        "enter": { "enum": ["none", "pop", "fade", "slide-up"], "default": "pop" }
      }
    },
    "arrow": {
      "description": "An arrow that draws itself from one point to another.",
      "allOf": [{ "$ref": "#/$defs/span" }],
      "type": "object",
      "required": ["type", "from_x", "from_y", "to_x", "to_y"],
      "unevaluatedProperties": false,
      "properties": {
        "type": { "const": "arrow" },
        "from_x": { "$ref": "#/$defs/fraction" }, "from_y": { "$ref": "#/$defs/fraction" },
        "to_x": { "$ref": "#/$defs/fraction" }, "to_y": { "$ref": "#/$defs/fraction" },
        "color": { "$ref": "#/$defs/colour" },
        "curve": { "type": "number", "minimum": -1, "maximum": 1, "default": 0.25 },
        "follow": { "$ref": "#/$defs/follow", "description": "The point it points at, moving: it follows someone through the shot." }
      }
    },
    "circle": {
      "description": "A ring that draws itself around something.",
      "allOf": [{ "$ref": "#/$defs/span" }],
      "type": "object",
      "required": ["type", "x", "y", "radius"],
      "unevaluatedProperties": false,
      "properties": {
        "type": { "const": "circle" },
        "x": { "$ref": "#/$defs/fraction" }, "y": { "$ref": "#/$defs/fraction" },
        "radius": { "type": "number", "exclusiveMinimum": 0, "maximum": 0.5, "description": "Fraction of the frame's width." },
        "color": { "$ref": "#/$defs/colour" },
        "follow": { "$ref": "#/$defs/follow", "description": "Its centre, moving: it stays around someone through the shot." }
      }
    },
    "follow": {
      "type": "array",
      "description": "Where a mark's point is over time, in seconds from when the mark appears (tools/marketing places these from a shot's track); straight lines between keys.",
      "items": {
        "type": "object",
        "required": ["at", "x", "y"],
        "additionalProperties": false,
        "properties": { "at": { "type": "number", "minimum": 0 }, "x": { "$ref": "#/$defs/fraction" }, "y": { "$ref": "#/$defs/fraction" } }
      }
    },
    "meme": {
      "description": "Meme formats as components: pov (a 'POV:' line), top-bottom (big text above and below), nobody ('Nobody:' / 'Karen:'), caption-bar (a white bar of text above the picture), expectation-reality (tags on the two halves of a split).",
      "allOf": [{ "$ref": "#/$defs/span" }],
      "type": "object",
      "required": ["type", "template"],
      "unevaluatedProperties": false,
      "properties": {
        "type": { "const": "meme" },
        "template": { "enum": ["pov", "top-bottom", "nobody", "caption-bar", "expectation-reality"] },
        "text": { "$ref": "#/$defs/text" },
        "top": { "$ref": "#/$defs/text" },
        "bottom": { "$ref": "#/$defs/text" },
        "speaker": { "$ref": "#/$defs/text", "description": "nobody: who answers (defaults to Karen's name)." }
      }
    },
    "sfx": {
      "type": "object",
      "required": ["src", "at"],
      "additionalProperties": false,
      "properties": {
        "src": { "$ref": "#/$defs/file" },
        "at": { "type": "number", "minimum": 0, "description": "Seconds into the scene." },
        "volume": { "type": "number", "minimum": 0, "maximum": 2, "default": 1 }
      }
    },
    "scene": {
      "type": "object",
      "required": ["duration", "visual"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "duration": { "type": "number", "exclusiveMinimum": 0, "maximum": 600 },
        "transition": { "$ref": "#/$defs/transition", "description": "Into this scene from the one before (ignored on the first)." },
        "visual": { "$ref": "#/$defs/visual" },
        "pip": { "$ref": "#/$defs/pip" },
        "overlays": { "type": "array", "items": { "$ref": "#/$defs/overlay" } },
        "sfx": { "type": "array", "items": { "$ref": "#/$defs/sfx" } }
      }
    },
    "word": {
      "type": "object",
      "required": ["text", "start", "end"],
      "additionalProperties": false,
      "properties": {
        "text": { "type": "string", "minLength": 1 },
        "start": { "type": "number", "minimum": 0, "description": "Seconds into the clip." },
        "end": { "type": "number", "minimum": 0 }
      }
    },
    "scriptLine": {
      "type": "object",
      "required": ["id", "speaker", "at", "text"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,39}$", "description": "Names the line's audio: audio/<edit id>/<language>/<id>.wav." },
        "speaker": { "enum": ["narrator", "karen"] },
        "at": { "type": "number", "minimum": 0, "description": "Seconds into the video the line should start (voice.py moves it later if the line before runs long)." },
        "text": { "$ref": "#/$defs/text" }
      }
    },
    "voiceClip": {
      "type": "object",
      "required": ["src", "at", "duration"],
      "additionalProperties": false,
      "properties": {
        "src": { "$ref": "#/$defs/file" },
        "at": { "type": "number", "minimum": 0, "description": "Seconds into the video." },
        "duration": { "type": "number", "exclusiveMinimum": 0, "description": "The clip's length (the music ducks under it)." },
        "speaker": { "enum": ["narrator", "karen"], "default": "narrator" },
        "volume": { "type": "number", "minimum": 0, "maximum": 2, "default": 1 },
        "words": { "type": "array", "items": { "$ref": "#/$defs/word" }, "description": "Word timings (Azure's WordBoundary) for the captions." }
      }
    },
    "music": {
      "type": "object",
      "required": ["src"],
      "additionalProperties": false,
      "properties": {
        "src": { "$ref": "#/$defs/file" },
        "offset": { "type": "number", "minimum": 0, "default": 0, "description": "Seconds into the track to start from." },
        "volume": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.35 },
        "duck": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.12, "description": "The volume while someone speaks." },
        "fadeIn": { "type": "number", "minimum": 0, "default": 0.5 },
        "fadeOut": { "type": "number", "minimum": 0, "default": 1.5 }
      }
    }
  }
}
