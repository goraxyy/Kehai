<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.tokenlimit.kehai-status</string>
  <key>ProgramArguments</key><array>
    <string>ABSOLUTE_PYTHON3</string><string>-B</string><string>-m</string>
    <string>tools.status.cli</string><string>collect</string><string>--repo</string>
    <string>ABSOLUTE_REPO</string><string>--home</string><string>PRIVATE_HOME_OUTSIDE_GIT</string>
  </array>
  <key>WorkingDirectory</key><string>ABSOLUTE_REPO</string>
  <key>StartCalendarInterval</key><dict><key>Hour</key><integer>2</integer><key>Minute</key><integer>15</integer></dict>
  <key>Umask</key><integer>63</integer><key>RunAtLoad</key><false/>
  <key>StandardOutPath</key><string>PRIVATE_HOME_OUTSIDE_GIT/collector.stdout.log</string>
  <key>StandardErrorPath</key><string>PRIVATE_HOME_OUTSIDE_GIT/collector.stderr.log</string>
</dict></plist>
